# ─────────────────────────────────────────────────────────────────────────────
# Sohersa Knowledge Grid
# ─────────────────────────────────────────────────────────────────────────────
# Copia este archivo a `.env.local` y rellena los valores.

# ── Sesión compartida ────────────────────────────────────────────────────────
# TIENE que ser el MISMO valor que en Digital Core, Deal Engine y Evaluación 360.
# Es lo que hace que quien ya entró en una de ellas entre aquí sin volver a
# autenticarse. Si difiere, cada app emite un JWT que las demás no verifican.
AUTH_SECRET=

# Las mismas credenciales de OAuth que usa el portal: Google concede permisos
# por CUENTA, no por aplicación. Cliente compartido de la plataforma.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Solo en producción. En local NextAuth lo deduce del propio servidor; en Vercel
# no puede, y sin esto el callback de Google vuelve a `localhost` y el inicio de
# sesión no cierra nunca.
# AUTH_URL=https://knowledge-grid.vercel.app

# ── Base de datos ────────────────────────────────────────────────────────────
# UNA sola base para toda la plataforma (`sohersa_unificada` en local, Neon en
# producción). Dentro viven tres esquemas:
#   core   el padrón: personas, proyectos, clientes. Lo mantiene el núcleo y
#          esta herramienta SOLO LO LEE.
#   grid   lo propio de Knowledge Grid: biblioteca, capacitaciones, rutas, FAQ.
#   public las tablas que comparten las demás herramientas.
DATABASE_URL="postgresql://usuario:clave@localhost:5432/sohersa_unificada"

# ── Acceso ───────────────────────────────────────────────────────────────────
# Dominio corporativo. Por omisión: gruposohersa.com
ALLOWED_DOMAIN=gruposohersa.com

# Correos externos autorizados, separados por comas. Opcional.
ALLOWED_EMAILS=

# Administradores de arranque, separados por comas.
#
# La lista de verdad vive en la tabla `grid.GridAdmin`, pero si está vacía —el
# día del despliegue— nadie podría entrar a Administración para dar de alta al
# primero. Esta variable rompe ese círculo.
GRID_ADMINS=

# ── Fuentes de Google ────────────────────────────────────────────────────────
# El cronograma de estandarización, de donde se sincroniza la biblioteca.
# Tiene un valor por omisión en el código; solo hace falta para apuntar a otro.
# CRONOGRAMA_SHEET_ID=
