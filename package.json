{
  "name": "sohersa-knowledge-grid",
  "version": "0.1.0",
  "private": true,
  "description": "Sohersa Knowledge Grid — manuales, herramientas, capacitaciones, rutas, FAQ y comunidad",
  "scripts": {
    "dev": "next dev -p 3004",
    "build": "npm run db:generate && next build",
    "start": "next start -p 3004",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:seed": "dotenv -e .env.local -- tsx scripts/seed.ts",
    "postinstall": "npm run db:generate",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:seed:real": "dotenv -e .env.local -- tsx scripts/seed-real.ts",
    "db:migrate": "dotenv -e .env.local -- node scripts/aplicar-migracion.mjs",
    "db:migrate:prod": "node scripts/aplicar-migracion.mjs",
    "db:limpiar": "dotenv -e .env.local -- tsx scripts/limpiar-ejemplos.ts",
    "db:limpiar:prod": "tsx scripts/limpiar-ejemplos-sql.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/pg": "^8.23.1",
    "clsx": "^2.1.1",
    "googleapis": "^175.0.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.3",
    "next-auth": "^5.0.0-beta.25",
    "pg": "^8.23.0",
    "prisma": "^6.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.1.3",
    "playwright": "^1.62.1",
    "postcss": "^8",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
